{
  "name": "mcp-resource-packs-server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "MCP server that serves a customer's resource pack and answers portfolio queries over their Smartsheet workspace",
  "bin": { "mcp-resource-packs": "dist/main.js" },
  "scripts": {
